# --- Microsoft Entra app registration (README part 1) ---
# AZURE_TENANT_ID is one of:
#   consumers  — a personal outlook.com / hotmail.com mailbox
#   common     — either kind
#   <GUID>     — one specific work Microsoft 365 tenant
# It must match the "Supported account types" you picked when registering the app.
AZURE_TENANT_ID=consumers
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Neon Postgres (README part 2) ---
DATABASE_URL=

# --- LLM provider (README part 3) ---
# The model only does extraction; pricing is deterministic and has no model in
# its path. So either provider works, and switching one cannot change a price.
#
# Set ONE key and leave LLM_PROVIDER blank to auto-detect, or set it explicitly
# to "anthropic" or "openai" if both keys are present.
LLM_PROVIDER=

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-terra     # gpt-6-astra is the flagship

# Base URL of this app. Must match a redirect URI on the Entra registration.
# Local: http://localhost:3000   Vercel: https://<your-app>.vercel.app
APP_BASE_URL=http://localhost:3000

# Any long random string — signs the session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
