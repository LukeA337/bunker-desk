# --- Microsoft Entra app registration (README part 1) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Neon Postgres (README part 2) ---
DATABASE_URL=

# --- Anthropic (README part 3) ---
ANTHROPIC_API_KEY=

# Base URL of this app. Must match a redirect URI on the Entra registration.
# Local: http://localhost:3000   Vercel: https://<your-app>.vercel.app
APP_BASE_URL=http://localhost:3000

# Any long random string — signs the session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
